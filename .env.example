# ============================================================
# Biến env cho docker-compose ở ROOT (copy sang `.env`)
# `docker compose up -d` sẽ tự đọc file `.env` này.
# ============================================================

# Timezone
TZ=Asia/Ho_Chi_Minh

# ─── MySQL ──────────────────────────────────────────────
DB_NAME=hris_db
DB_ROOT_PASSWORD=root
DB_EXPOSE_PORT=3306

# ─── Backend ────────────────────────────────────────────
BACKEND_EXPOSE_PORT=3001

# Generate giá trị an toàn:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_48bytes_hex_access_secret
JWT_REFRESH_SECRET=replace_me_with_48bytes_hex_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d

BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_EXPIRES_MINUTES=60

# CORS: đây là origin của FE mà BE chấp nhận.
CORS_ORIGIN=http://localhost:8080
APP_PUBLIC_URL=http://localhost:8080

# Mailer (để trống → reset link in ra console log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=HRIS Portal <no-reply@hris.local>

# ─── Frontend ───────────────────────────────────────────
FRONTEND_EXPOSE_PORT=8080
