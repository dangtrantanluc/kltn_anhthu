# ─── Server ─────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database (MySQL 8) ─────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=system_management

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_EXPIRES_IN=8h
JWT_ACCESS_SECRET=dev_access_secret_change_this_to_a_random_48_bytes_string_0123456789
JWT_REFRESH_SECRET=dev_refresh_secret_change_this_to_a_random_48_bytes_string_9876543210
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d

# ─── Auth / Security ────────────────────────────────────
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_EXPIRES_MINUTES=60

# ─── CORS ───────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Mailer (dev: leave empty → log to console) ─────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="HRIS Portal <no-reply@hris.local>"
APP_PUBLIC_URL=http://localhost:5173
